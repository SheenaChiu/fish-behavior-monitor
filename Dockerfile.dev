# ============================================================
# Fish Vitality Monitoring - 開發 / 訓練環境
# ============================================================
# Tested on:
#   OS:     Ubuntu 22.04
#   Python: 3.12
#   CUDA:   13.0 (base image 12.4-devel + PyTorch cu130 wheel)
#   GPU:    NVIDIA RTX 5090
#
# 本 Dockerfile 使用 CUDA 12.4-devel base image (比 runtime 大，但含 nvcc
# 等編譯工具，部分訓練依賴 (如 flash-attention) 可能需要)。
#
# Build:
#   docker build -f Dockerfile.dev -t fish-vitality-dev .
#
# Run (互動模式):
#   docker run --gpus all -it -v $(pwd):/workspace fish-vitality-dev
# ============================================================

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

# ------------------------------------------------------------
# 1. 系統套件 + Python 3.12 (多裝了 vim 等開發工具)
# ------------------------------------------------------------
RUN apt-get update && apt-get install -y \
        wget \
        curl \
        git \
        vim \
        software-properties-common \
        libgl1-mesa-glx \
        libglib2.0-0 \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# 2. 將 python / python3 預設指向 3.12
# ------------------------------------------------------------
RUN update-alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1

# ------------------------------------------------------------
# 3. 安裝 pip 與 setuptools / wheel
# ------------------------------------------------------------
RUN wget https://bootstrap.pypa.io/get-pip.py \
    && python get-pip.py \
    && rm get-pip.py \
    && pip install "setuptools<70.0.0" wheel

# ------------------------------------------------------------
# 4. 安裝 PyTorch (cu130 wheel)
# ------------------------------------------------------------
RUN pip install --no-cache-dir \
        torch==2.12.0 \
        torchvision==0.27.0 \
        torchaudio==2.11.0 \
    --index-url https://download.pytorch.org/whl/cu130

# ------------------------------------------------------------
# 5. 安裝推論 + 訓練依賴
# ------------------------------------------------------------
WORKDIR /workspace
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

# ------------------------------------------------------------
# 6. 複製專案檔案
# ------------------------------------------------------------
COPY . .

# ------------------------------------------------------------
# 7. 開發環境進入 bash
# ------------------------------------------------------------
CMD ["/bin/bash"]